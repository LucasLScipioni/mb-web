{
  "name": "mb-web-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "install:all": "npm install && npm install --prefix server",
    "project": "npm run build && npm run server:start",
    "server:start": "npm start --prefix server",
    "format": "prettier --write \"src/**/*.{js,vue,scss,css,html,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,scss,css,html,json,md}\""
  },
  "dependencies": {
    "formik": "^2.4.6",
    "vue": "^3.5.17",
    "vue-the-mask": "^0.11.1",
    "vue-toastification": "^2.0.0-rc.5",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "^3.6.2",
    "sass": "^1.89.2",
    "vite": "^7.0.4"
  }
}
